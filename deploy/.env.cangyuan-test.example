SUB2API_IMAGE=ghcr.io/jankin-chen123/sub2api-custom:cangyuan-image-test-latest
TEST_BIND_HOST=127.0.0.1
TEST_HOST_PORT=18080
TZ=Asia/Shanghai

POSTGRES_USER=sub2api_test
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=sub2api_test
REDIS_PASSWORD=replace-with-a-long-random-redis-password

ADMIN_EMAIL=cangyuan-test@example.invalid
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
JWT_SECRET=replace-with-a-64-character-random-secret
TOTP_ENCRYPTION_KEY=replace-with-a-64-character-random-key

MINIO_ROOT_USER=sub2api_test
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
IMAGE_STORAGE_BUCKET=sub2api-images

DEDICATED_IMAGE_ENABLED=true
DEDICATED_IMAGE_WORKER_ENABLED=true
DEDICATED_IMAGE_CODEX_BRIDGE_ENABLED=false
DEDICATED_IMAGE_FALLBACK_TO_GENERAL=false
IMAGE_STORAGE_ENABLED=true
